{
  "name": "dsh-historica",
  "version": "1.1.0",
  "type": "module",
  "description": "Historical satellite imagery (Landsat C2 L2) planning, windowed download, multi-period comparison figures and technical reports, with a map range picker in the DSH Web UI.",
  "license": "MIT",
  "author": "Fagu Yu",
  "repository": {
    "type": "git",
    "url": "https://github.com/kue0000/dsh-historica.git"
  },
  "homepage": "https://github.com/kue0000/dsh-historica#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "landsat",
    "satellite-imagery",
    "historical-imagery",
    "remote-sensing",
    "gis"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "runtime/**/*",
    "README.md",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
