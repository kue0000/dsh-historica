{
  "data": {
    "provider": "landsat-c2-l2",
    "stac_url": "https://planetarycomputer.microsoft.com/api/stac/v1",
    "providers": {
      "landsat-c2-l2": {
        "enabled": true,
        "kind": "stac-pc",
        "bands": ["red", "green", "blue", "qa_pixel"],
        "scale": 2.75e-05,
        "offset": -0.2,
        "license": "USGS/NASA Landsat Collection 2，公有领域，可自由使用（需署名 USGS）"
      },
      "sentinel-2-l2a": {
        "enabled": false,
        "kind": "stac-pc",
        "bands": ["B04", "B03", "B02", "SCL"],
        "scale": 1.0,
        "offset": 0.0,
        "min_year": 2015,
        "license": "Copernicus Sentinel-2，开放许可（需署名 ESA）"
      },
      "tianditu": {
        "enabled": false,
        "kind": "wmts-key",
        "key_env": "TIANDITU_KEY",
        "license": "需在 https://console.tianditu.gov.cn/ 申请 key，按调用量计费/限流；坐标系 CGCS2000，需重投影",
        "note": "本插件默认关闭；开启前须由用户提供 key 并确认配额"
      },
      "gaofen": {
        "enabled": false,
        "kind": "manual",
        "license": "高分系列需商业授权或科研申请，非开放数据；插件不内置分发",
        "note": "默认不纳入"
      },
      "local": {
        "enabled": true,
        "kind": "file",
        "license": "用户自备"
      }
    }
  },
  "boundary": {
    "sources": ["datav", "gadm"],
    "fallback_order": ["datav", "gadm2", "gadm3"],
    "datav_all": "https://geo.datav.aliyun.com/areas_v3/bound/all.json",
    "datav_bound_single": "https://geo.datav.aliyun.com/areas_v3/bound/{adcode}.json",
    "datav_bound": "https://geo.datav.aliyun.com/areas_v3/bound/{adcode}_full.json",
    "gadm_base": "https://geodata.ucdavis.edu/gadm/gadm4.1/json/",
    "scrub_km": 0.0,
    "simplify_m": 0.0,
    "min_overlap_warn": 0.95,
    "area_sanity_ratio": 2.0,
    "note": "DataV 为 GCJ-02，插件自动反算到 WGS84 并记录偏移量；GADM 为 WGS84 但区县建制可能滞后；area_sanity_ratio 用于拦截“回退到上级行政区”导致的面积异常"
  },
  "area": {
    "display_scope": "boundary",
    "coverage_scope": "boundary",
    "cost_scope": "bbox",
    "coverage_thresholds": {
      "full": 0.95,
      "accept": 0.85,
      "readable_full": 0.85,
      "readable_accept": 0.70
    },
    "report_all_scopes": true,
    "note": "展示与覆盖率一律用真实区界；外接矩形只用于窗口与成本；有效像元覆盖率单列"
  },
  "grid": {
    "crs": "auto-utm",
    "res": 30.0,
    "pad_m": 0.0,
    "align_to_pixel": true
  },
  "selection": {
    "cloud_max": 20.0,
    "min_coverage": 0.60,
    "target_coverage": 0.995,
    "date_group_span_days": 0,
    "mixed_max_window_days": 32,
    "max_scenes_per_epoch": 4,
    "allow_mixed_by_default": true,
    "mixed_gain_pp": 0.05,
    "max_date_span_days": 30,
    "prefer_missing_over_crossseason": true,
    "crossseason_cloud_max": 20.0,
    "season_window_days": 45,
    "season_fallback_min_coverage": 0.60,
    "weights": {
      "coverage": 0.40,
      "cloud": 0.25,
      "sun": 0.15,
      "date": 0.20,
      "season": 0.15
    },
    "sun_target_deg": 45.0,
    "season_note": "v1.1 默认同季：各期先按初选日期圆均值确定共同窗口（±season_window_days），再在窗口内选景；窗口内无可用低云景时回退并标记 cross_season，不静默放开。--season-window 0 关闭。weights.season 为季节一致性项（窗口中心 1.0，偏移=窗口半宽 0.5，≥2×半宽 0）。"
  },
  "window": {
    "block_px": 256,
    "halo_blocks": 1,
    "overlap_read_factor": 1.5,
    "seam_overlap_ratio": 0.07,
    "note": "窗口向外扩 1 块 halo；overlap_read_factor 是多轨冗余实测拟合值，用于成本模型"
  },
  "gsd": {
    "default": 30,
    "tiers": [30, 60, 90],
    "transfer_ratio": { "30": 1.0, "60": 0.25, "90": 0.111 },
    "note": "60/90 m 走 COG 内部 overview，仅限宏观建成区判读"
  },
  "estimate": {
    "probe_bytes": 8388608,
    "probe_timeout_s": 180,
    "probe_rounds": 5,
    "probe_workers": 0,
    "probe_diagnostic_samples": 1,
    "probe_agg": "median",
    "interval_percentiles": [5, 95],
    "min_samples_for_percentile": 4,
    "block_overhead": 1.25,
    "open_latency_s": 4.8,
    "processing_s_per_mpx": 1.2,
    "time_range": [0.8, 1.3],
    "fallback_speed_mbps": 0.21,
    "compression_fallback": 0.6,
    "sensitivity_speeds_mbps": [0.05, 0.1, 0.2, 0.5, 1.0],
    "calibration": {
      "path": "cache/calibration.json",
      "window": 5
    },
    "warn_error_ratio": 0.30,
    "note": "v1.1：探针与 fetch.workers 同数并发（probe_workers=0 时自动取 fetch.workers），按轮聚合吞吐取中位；单流探针只作 diagnostic。样本池 = 本轮并发轮次 + 最近 window 次校准净吞吐 + 这些运行在下载期看门狗记录的分块吞吐（每条最多抽 10 个，避免单次运行过权）；点估计取中位，区间取 p5–p95。预估只用于提醒/分批，不决定任务是否继续。"
  },
  "align": {
    "ncc_min": 0.2,
    "max_shift_px": 12,
    "note": "峰值落在 ±max_shift 边界或 NCC 低于 ncc_min 时输出「未锁定」，不给位移值"
  },
  "gates": {
    "auto_max_min": 10,
    "ask_if_coverage_below": 0.85,
    "ask_if_readable_below": 0.70,
    "ask_if_scenes_ge": 4,
    "ask_if_cross_season": true,
    "ask_if_estimate_over_min": 10,
    "note": "默认闸门：短任务且满覆盖自动放行，其余必须用户确认；readable 为区界内有效像元占比"
  },
  "fetch": {
    "workers": 4,
    "timeout_s": 120,
    "retries": 6,
    "cache_dir": "cache",
    "resume": true,
    "blocksize": 1048576,
    "feather_km": 2.0,
    "watchdog": {
      "enabled": true,
      "consecutive_below": 3,
      "below_fraction": 0.5,
      "min_sample_mb": 2.0,
      "note": "运行期看门狗：连续 3 个「单波段窗口读取」（内部按 256 px 块请求）的等效吞吐低于预估区间低端（p5）速度的 1/2 → 暂停、落盘进度、可续跑。预测值不决定任务是否继续。看门狗记录的每块吞吐会并入下一轮预估的样本池。"
    }
  },
  "qc": {
    "thin_cirrus": {
      "enabled": true,
      "swir_asset": "swir16",
      "brightness_min": 0.40,
      "ndsi_abs_max": 0.25,
      "qa_clear_bits": "bit1-4 == 0",
      "source": "阈值由延平 2003-02-02（LT05_L2SP_120042_20020202_02_T1）三片疑似薄卷云斑块的逐像元统计定：逐波段最小值（min RGB 反射率）p25 = 0.444 / 0.452 / 0.405 → 取 0.40；|NDSI| p95 = 0.232 / 0.271 / 0.272 → 取 0.25；QA_PIXEL bit1–4 全为 0。完整统计见 runs/yanping_real/estimate/20261104_143500/out/thin_cirrus_thresholds.json",
      "note": "薄卷云像元从可读覆盖中扣除并在图上用品红细网点标注；不改变辐射值。阈值来自亚热带山地（延平），珠三角高反射屋面/裸土存在误判风险，报告中单列。"
    }
  },
  "tone": {
    "dos_percentile": 1.5,
    "wb_target": [1.0, 0.775, 0.61],
    "stretch": [0.004, 0.36],
    "gamma": 0.80,
    "saturation": 1.08,
    "anchor": [0.055, 0.47],
    "contrast": 1.06,
    "target_mean": 0.285
  },
  "compose": {
    "dpi": 200,
    "max_cols": 2,
    "boundary_color": "#d81e26",
    "boundary_width_px": 4.2,
    "scale_km": 5.0,
    "missing_hatch": true,
    "font": "Microsoft YaHei",
    "background": "#fbfaf7",
    "ink": "#171717"
  },
  "report": {
    "title_suffix": "历史卫星影像对比",
    "mark_inference": "【推断】",
    "include_candidate_ranking": true,
    "include_estimate_vs_actual": true
  }
}
